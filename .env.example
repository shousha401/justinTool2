# ── Server ─────────────────────────────────────────────
PORT=3004

# ── Swarmbox (PostgREST inventory API — no auth, read-only) ──
SWARMBOX_BASE_URL=https://jdfood.swarmbox.com:443/pg-api
SWARMBOX_TIMEOUT_MS=30000      # per-request timeout (AbortController)
SWARMBOX_CONCURRENCY=4         # max parallel Swarmbox calls (process-wide cap)

# Slots held back for user-facing calls. Bulk background work (the catalog sweep,
# the price build, the summary backfill) may use at most CONCURRENCY - RESERVED, so
# a page that needs one fresh Swarmbox call is never stuck behind a multi-minute
# rebuild. Without this, opening Production Margin during a rebuild just spins.
SWARMBOX_RESERVED_SLOTS=1

# Circuit breaker — last line of defence against hammering a failing Swarmbox.
# After this many CONSECUTIVE failures, ALL calls short-circuit for the cooldown
# instead of every module retrying into a brownout. Any success resets the count.
# Should only ever trip in a real outage. Set SWARMBOX_BREAKER=off to disable.
SWARMBOX_BREAKER_FAILS=40
SWARMBOX_BREAKER_COOLDOWN_MS=60000

# ── Valuation tuning ───────────────────────────────────
VALUE_LOOKBACK_DAYS=360        # sales window for "last price" (Swarmbox caps item-filtered queries at 360)
VALUE_CACHE_TTL_MS=21600000    # serve the saved table instantly; refresh in background once older than this (6h)
CATALOG_ROW_BUDGET=50000       # if a wildcard prefix returns >= this many lot rows, subdivide it (safety guard)
CATALOG_ATTEMPTS=3             # tries per prefix before a slice is written off (timeouts are NOT retried — they're split)
CATALOG_CALL_BUDGET=1500       # hard ceiling on Swarmbox calls per sweep; abort rather than storm the API
VALUE_REFRESH_HOUR=5           # hour (0–23, VM local time) for the automatic daily price refresh
# VALUE_DB_PATH=./data/value.db  # where the SQLite price store lives (default ./data/value.db)

# ── Production margin tab ───────────────────────────────
PRODUCTION_CACHE_TTL_MS=300000 # how long a built day's margin report is reused (5m — today's numbers move during the shift)
TOLL_LOOKBACK_DAYS=90          # freshness window for the live toll rate (most recent external CMP sale per item)
PRODUCTION_MAX_DAY_ATTEMPTS=6  # give up rebuilding a day after this many failures (backs off 5m→15m→30m→1h→4h between tries)
