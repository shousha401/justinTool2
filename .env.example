# ── Server ─────────────────────────────────────────────
PORT=3004

# ── Swarmbox (PostgREST inventory API — no auth, read-only) ──
SWARMBOX_BASE_URL=https://jdfood.swarmbox.com:443/pg-api
SWARMBOX_TIMEOUT_MS=30000      # per-request timeout (AbortController)
SWARMBOX_CONCURRENCY=4         # max parallel Swarmbox calls (process-wide cap)

# ── Valuation tuning ───────────────────────────────────
VALUE_LOOKBACK_DAYS=360        # sales window for "last price" (Swarmbox caps item-filtered queries at 360)
VALUE_CACHE_TTL_MS=21600000    # how long a built value table is reused before a re-sweep (6h)
CATALOG_ROW_BUDGET=50000       # if a wildcard prefix returns >= this many lot rows, subdivide it (safety guard)
